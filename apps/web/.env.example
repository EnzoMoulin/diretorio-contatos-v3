APP_NAME="Diretório de Contatos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail sobe o Postgres do compose; fora do Sail, troque DB_HOST.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=diretorio
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Usuário criado por `php artisan migrate --seed`. Sem ADMIN_SENHA, o seeder
# gera uma senha aleatória e a imprime uma única vez no terminal.
ADMIN_EMAIL=admin@diretorio.test
ADMIN_SENHA=

# Caminho para o seed mascarado do v2. Vazio = irmão ../diretorio-contatos-v2/
# seed_mascarado.json; se o arquivo não existir, o seeder cria dados sintéticos.
SEED_JSON=

# Sail usa o UID/GID do host para os arquivos montados.
WWWUSER=1000
WWWGROUP=1000
